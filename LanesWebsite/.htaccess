# Apache configuration for the Lane Studio website at the root of
# lanestudio.marcelmarzec.com. There is no build step, so this ships with the
# site. The editor lives in /editor/ with its own .htaccess.

DirectoryIndex index.php, index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS. The second and third conditions cover hosts that terminate
  # TLS at a proxy; without them this would loop forever.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{SERVER_PORT} !=443
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Partials and Markdown are never served.
  RewriteRule ^includes/ - [F,L]
  RewriteRule \.md$ - [F,L]

  # The rules below match THE_REQUEST, which keeps the *original* request line
  # during an ErrorDocument subrequest. Without this guard a refused
  # /includes/foo.php would come back as a redirect instead of a 403.
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^ - [E=CLEAN_URLS:1]

  # Drop the .php extension: one canonical URL per page.
  # The XML sitemap is PHP behind an .xml address; /sitemap.php itself goes
  # there too. Named in robots.txt for search engines.
  RewriteCond %{ENV:CLEAN_URLS} =1
  RewriteCond %{THE_REQUEST} \s/+sitemap(?:\.php)?/?[\s?] [NC]
  RewriteRule ^ /sitemap.xml [R=301,L]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  RewriteCond %{ENV:CLEAN_URLS} =1
  RewriteCond %{THE_REQUEST} \s/+(.*?)index\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  RewriteCond %{ENV:CLEAN_URLS} =1
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Serve the clean URL. Real directories are skipped so /editor/ still
  # resolves through its own index.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

# The site's own Content-Security-Policy. The host's parent folder (the
# marcelmarzec.com site) sends a policy of its own, written for that site, which
# blocks MapLibre, OpenFreeMap's tiles and Google Fonts here; it is removed from
# both of mod_headers' tables first, so only this one is sent. The editor in
# /editor/ removes it again in its own .htaccess (scripts/build_lanes_site.js).
#   script-src  MapLibre from jsDelivr (statistics map); no inline scripts
#   style-src   MapLibre's CSS, Google Fonts' CSS, inline style attributes
#   connect-src OpenFreeMap's style, tiles, glyphs and sprites
#   worker-src  MapLibre's worker, started from a blob: URL
<IfModule mod_headers.c>
  Header always unset Content-Security-Policy
  Header unset Content-Security-Policy
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://tiles.openfreemap.org; worker-src 'self' blob:; child-src blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>

# error.php reads the original status from REDIRECT_STATUS.
ErrorDocument 400 /error.php
ErrorDocument 401 /error.php
ErrorDocument 403 /error.php
ErrorDocument 404 /error.php
ErrorDocument 500 /error.php
ErrorDocument 502 /error.php
ErrorDocument 503 /error.php
